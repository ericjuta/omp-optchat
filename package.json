{
  "name": "@ericjuta/omp-optchat",
  "version": "0.10.2",
  "description": "An endless OMP chat backed by a durable log and binary summary memory tree, inspired by Victor Taelin's OptChat.",
  "type": "module",
  "private": true,
  "engines": {
    "bun": ">=1.3.14"
  },
  "omp": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "files": [
    "src",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "bun test tests --path-ignore-patterns 'tests/host/**'",
    "test:host": "bun test tests/host",
    "typecheck": "tsc --noEmit",
    "smoke": "bun run scripts/smoke.ts",
    "evidence:recall": "bun run scripts/evidence-recall.ts",
    "evidence:retrieval": "bun run scripts/retrieval-compare.ts",
    "evals:recall": "bun run evals/recall/run.ts",
    "evals:rules": "bun run evals/rules/run.ts"
  },
  "peerDependencies": {
    "@oh-my-pi/pi-ai": ">=18.10.3",
    "@oh-my-pi/pi-catalog": ">=18.10.3",
    "@oh-my-pi/pi-coding-agent": ">=18.10.3"
  },
  "peerDependenciesMeta": {
    "@oh-my-pi/pi-ai": {
      "optional": true
    },
    "@oh-my-pi/pi-catalog": {
      "optional": true
    },
    "@oh-my-pi/pi-coding-agent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@oh-my-pi/pi-ai": "18.10.3",
    "@oh-my-pi/pi-catalog": "18.10.3",
    "@oh-my-pi/pi-coding-agent": "18.10.3",
    "@types/bun": "^1.3.0",
    "typescript": "^5.9.3"
  }
}
