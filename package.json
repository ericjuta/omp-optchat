{
  "name": "@ericjuta/omp-optchat",
  "version": "0.5.0",
  "description": "An endless OMP chat backed by a durable log and binary summary memory tree, inspired by Victor Taelin's OptChat.",
  "type": "module",
  "private": true,
  "engines": {
    "bun": ">=1.3.14"
  },
  "omp": {
    "extensions": ["./src/index.ts"]
  },
  "files": ["src", "README.md", "CHANGELOG.md"],
  "scripts": {
    "test": "bun test tests",
    "typecheck": "tsc --noEmit",
    "smoke": "bun run scripts/smoke.ts",
    "evidence:recall": "bun run scripts/evidence-recall.ts"
  },
  "peerDependencies": {
    "@oh-my-pi/pi-ai": ">=18.9.0",
    "@oh-my-pi/pi-catalog": ">=18.9.0",
    "@oh-my-pi/pi-coding-agent": ">=18.9.0"
  },
  "peerDependenciesMeta": {
    "@oh-my-pi/pi-ai": {
      "optional": true
    },
    "@oh-my-pi/pi-catalog": {
      "optional": true
    },
    "@oh-my-pi/pi-coding-agent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@oh-my-pi/pi-ai": "18.9.1",
    "@oh-my-pi/pi-catalog": "18.9.1",
    "@oh-my-pi/pi-coding-agent": "18.9.1",
    "@types/bun": "^1.3.0",
    "typescript": "^5.9.3"
  }
}
